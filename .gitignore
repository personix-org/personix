# Pamphlet build — verzujeme ZDROJE buildu (build.sh, pamphlet*.tex master,
# frontmatter/backmatter/epub config, watermark.tex.template), ale NE generované
# artefakty. Finální PDF/EPUB jsou v release/.
docs/pamphlet/*/build/chapters/
docs/pamphlet/*/build/chapters2col/
docs/pamphlet/*/build/figures/
docs/pamphlet/*/build/figures-bleed/
docs/pamphlet/*/build/*.pdf
docs/pamphlet/*/build/*.epub
docs/pamphlet/*/build/watermark.tex
docs/pamphlet/*/build/pamphlet-draft.tex
docs/pamphlet/*/build/figbg.tex
# Merged md (generované build skriptem z rozbitých komponent prechod/ a roles/)
docs/pamphlet/*/**/.merged.md

# Whitepaper build outputs (zdroj .tex je v docs/whitepaper/, ne v build/)
docs/whitepaper/build/

# LaTeX intermediate
*.aux
*.log
*.toc
*.out
*.bbl
*.blg
*.synctex.gz
*.fdb_latexmk
*.fls

# macOS
.DS_Store

# Editor
.idea/
.vscode/
.obsidian/
*.swp
*.swo

# OS temp
*~

# Audio masters & work-in-progress (publikované versions jsou v release/)
release/audio/
release/transcripts/

# Info graphics work-in-progress (historické experimenty)
docs/pamphlet/Info Graphics/
