   362,
   568,
   449
  ],
  "angle": 2.1,
  "joined": false
 },
 {
  "text": "2. Activates claims for you when events fall within an agreed scope",
  "role": "body",
  "bbox": [
   151,
   455,
   650,
   528
  ],
  "angle": 1.7,
  "joined": false
 },
 {
  "text": "3. Spares you from publishing every minor 'what if'",
  "role": "body",
  "bbox": [
   146,
   527,
   629,
   610
  ],
  "angle": 0,
  "joined": false
 },
 {
  "text": "4. Stakes their own reputation on each claim they sign",
  "role": "body",
  "bbox": [
   151,
   610,
   619,
   682
  ],
  "angle": 0,
  "joined": false
 },
 {
  "text": "5. Returns the rights to you the moment you revoke",
  "role": "body",
  "bbox": [
   149,
   687,
   569,
   763
  ],
  "angle": -1.2,
  "joined": false
 },
 {
  "text": "I'll keep two for the things only I can speak to. The rest — handle them for me.",
