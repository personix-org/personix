[
 {
  "text": "WHAT IS A DID POLICY?",
  "role": "title",
  "bbox": [
   48,
   46,
   1102,
   161
  ],
  "angle": 0,
  "joined": false
 },
 {
  "text": "EXAMPLES OF THE DID POLICY ARTEFACT",
  "role": "caption",
  "bbox": [
   53,
   185,
   1065,
   264
  ],
  "angle": 0,
  "joined": false
 },
 {
  "text": "my policy is not about how a claim is written — that is the standard's job. My policy is how I decide whether to care about the claim at all: do I trust who signed it, do I trust the authority behind their standard, and is the matter even worth my attention?",
  "role": "body",
  "bbox": [
   1537,
   70,
   2440,
   240
  ],
  "angle": 0,
  "joined": false
 },
 {
  "text": "THE STANDARD — INHERITED DEFAULTS",
  "role": "label",
  "bbox": [
   291,
   353,
   1149,
   407
  ],
  "angle": 0,
  "joined": false
 },
 {
  "text": "ISSUER REPUTATION FLOOR",
  "role": "label",
  "bbox": [
   476,
   546,
   690,
   668
  ],
  "angle": 0,
  "joined": false
 },
 {
  "text": "I accept issuers with reputation above five of ten",
  "role": "body",
  "bbox": [
   714,
   553,
   1128,
   646
  ],
  "angle": 0,
  "joined": false
 },
 {
  "text": "AUTHORITY TRUST LIST",
  "role": "label",
  "bbox": [
   473,
   697,
   690,
   797
  ],
  "angle": 0,
  "joined": false
 },
 {
  "text": "I accept standards from any authority whose own reputation is above four of ten",
  "role": "body",
  "bbox": [
   721,
   684,
   1156,
   807
  ],
  "angle": 0,
  "joined": false
 },
 {
  "text": "SUBSTANCE FILTER",
  "role": "label",
  "bbox": [
   473,
   852,
   681,
   947
  ],
  "angle": 0,
  "joined": false
 },
 {
  "text": "I process any claim whose matter weighs above the 'trifling' mark",
  "role": "body",
  "bbox": [
   710,
   837,
   1144,
   964
  ],
  "angle": 0,
  "joined": false
 },
 {
  "text": "ANTI-SPAM PRICING CURVE",
  "role": "label",
  "bbox": [
   476,
   1010,
   719,
   1114
  ],
  "angle": 0,
  "joined": false
 },
 {
  "text": "submitting to me is cheap for substantive, rare claims — and grows fast for petty or repeated ones",
  "role": "body",
  "bbox": [
   721,
   983,
   1173,
   1134
  ],
  "angle": 0,
  "joined": false
 },
 {
  "text": "COMBINED WEIGHTING",
  "role": "label",
  "bbox": [
   476,
   1163,
   690,
   1274
  ],
  "angle": 0,
  "joined": false
 },
 {
  "text": "issuer-rep and authority-rep multiply; petty-substance halves the result",
  "role": "body",
  "bbox": [
   717,
   1157,
   1181,
   1274
  ],
  "angle": 0,
  "joined": false
 },
 {
