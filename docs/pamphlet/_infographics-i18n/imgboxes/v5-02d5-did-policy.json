  "role": "label",
  "bbox": [
   1458,
   1247,
   1690,
   1307
  ],
  "angle": 0,
  "joined": false
 },
 {
  "text": "added — each new claim from the same issuer about me in a year costs ten times the last",
  "role": "body",
  "bbox": [
   1761,
   1114,
   2236,
   1228
  ],
  "angle": 0,
  "joined": false
 },
 {
  "text": "petty nuisance claims cost me nothing to ignore — I simply do not read them",
